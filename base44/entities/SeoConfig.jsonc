{
  "name": "SeoConfig",
  "type": "object",
  "properties": {
    "site_name": {
      "type": "string",
      "description": "Nome da marca exibido no t\u00edtulo e OG site_name",
      "default": "Boldlife"
    },
    "default_seo_title": {
      "type": "string",
      "description": "T\u00edtulo SEO padr\u00e3o do site"
    },
    "default_seo_description": {
      "type": "string",
      "description": "Meta description padr\u00e3o (max 160 caracteres)"
    },
    "social_image": {
      "type": "string",
      "description": "URL da imagem social padr\u00e3o (Open Graph / Twitter)"
    },
    "logo_url": {
      "type": "string",
      "description": "URL p\u00fablica e permanente da logo oficial"
    },
    "favicon_url": {
      "type": "string",
      "description": "URL do favicon"
    },
    "gsc_verification": {
      "type": "string",
      "description": "C\u00f3digo de verifica\u00e7\u00e3o do Google Search Console"
    },
    "ga4_id": {
      "type": "string",
      "description": "Measurement ID do Google Analytics 4 (ex: G-XXXXXXX)"
    },
    "gtm_id": {
      "type": "string",
      "description": "Container ID do Google Tag Manager (ex: GTM-XXXXXX)"
    },
    "instagram": {
      "type": "string",
      "description": "URL oficial do Instagram"
    },
    "facebook": {
      "type": "string",
      "description": "URL oficial do Facebook"
    },
    "youtube": {
      "type": "string",
      "description": "URL oficial do YouTube"
    },
    "linkedin": {
      "type": "string",
      "description": "URL oficial do LinkedIn"
    },
    "tiktok": {
      "type": "string",
      "description": "URL oficial do TikTok"
    },
    "twitter": {
      "type": "string",
      "description": "URL oficial do X / Twitter"
    },
    "phone": {
      "type": "string",
      "description": "Telefone oficial"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp (DDI+DDD+n\u00famero, somente d\u00edgitos)"
    },
    "email": {
      "type": "string",
      "description": "E-mail oficial de contato"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o empresarial p\u00fablico"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ p\u00fablico"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social p\u00fablica"
    }
  },
  "required": [
    "site_name"
  ]
}